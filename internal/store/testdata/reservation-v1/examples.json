  ],
  "reconciliation": [
    {"case": "identical_replay", "operation": "claim", "request_key": "claim-example-1", "receipt_state": "committed", "replayed": true, "same_receipt_id": "receipt-claim-1", "next_action": "use recorded outcome"},
    {"case": "call_not_committed", "operation": "claim", "request_key": "claim-example-4", "receipt_state": "not_committed", "replayed": false, "next_action": "retry same key"},
    {"case": "ambiguous_commit", "operation": "claim", "request_key": "claim-example-5", "receipt_state": "unresolved", "replayed": false, "next_action": "stop and reconcile same key"}
  ],
  "status_example": {"state": "held", "reservation_id": "01a0d755-0000-7000-8000-000000000012", "fence": "2", "own_work_ref": "attempt-example-3", "task_revision": 4},
  "refusal_envelope_example": {"code": "context_unavailable", "message": "The selected team context could not be verified.", "active_mode": "team", "retryable": true, "next_action": "Retry verification later with the same context and key.", "correlation_id": "correlation-example-1"},
  "refusals": [
    {"case": "revoked_token", "code": "invalid_credential", "http_status": 401, "retryable": false, "active_mode": null, "next_action": "Recover the individual credential through the authorized flow."},
    {"case": "unlinked_actor", "code": "identity_link_required", "http_status": 403, "retryable": false, "active_mode": "team", "next_action": "Complete the verified identity proof flow."},
    {"case": "wrong_link", "code": "identity_mismatch", "http_status": 403, "retryable": false, "active_mode": "team", "next_action": "Stop and reconcile the configured identity."},
    {"case": "missing_team_binding", "code": "context_missing", "http_status": 403, "retryable": false, "active_mode": "team", "next_action": "Start or resume the aicrew session in this conversation."},
    {"case": "stale_session", "code": "context_stale", "http_status": 403, "retryable": false, "active_mode": "team", "next_action": "Resume the team context and reconcile outstanding work."},
    {"case": "introspection_outage", "code": "context_unavailable", "http_status": 503, "retryable": true, "active_mode": "team", "next_action": "Retry verification later with the same context and key."},
    {"case": "missing_project_grant", "code": "grant_denied", "http_status": 403, "retryable": false, "active_mode": "team", "next_action": "Request an authorized project grant change."},
    {"case": "role_downgrade", "code": "role_forbidden", "http_status": 403, "retryable": false, "active_mode": "team", "next_action": "Use the permitted aicrew flow."},
    {"case": "inaccessible_task", "code": "task_unavailable", "http_status": 404, "retryable": false, "active_mode": "team", "next_action": "Verify the task reference with an authorized project reader."},
    {"case": "dependency_denied", "code": "dependency_unresolved", "http_status": 404, "retryable": false, "active_mode": "team", "next_action": "Verify readable dependency evidence before retrying the same key."},
    {"case": "dependency_outage", "code": "dependency_unresolved", "http_status": 503, "retryable": true, "active_mode": "team", "next_action": "Retry verification later with the same context and key."},
    {"case": "competing_hold", "code": "reservation_conflict", "http_status": 409, "retryable": false, "active_mode": "team", "next_action": "Read own authorized status and reconcile."},
    {"case": "changed_task", "code": "revision_conflict", "http_status": 409, "retryable": false, "active_mode": "team", "next_action": "Read the current task revision before a new operation."},
    {"case": "stale_worker", "code": "stale_fence", "http_status": 409, "retryable": false, "active_mode": "team", "next_action": "Stop the old holder and inspect own authorized status."},
    {"case": "changed_replay", "code": "idempotency_conflict", "http_status": 409, "retryable": false, "active_mode": "team", "next_action": "Investigate changed input under the original key."},
    {"case": "unknown_receipt", "code": "receipt_unresolved", "http_status": 503, "retryable": true, "active_mode": "team", "next_action": "Stop later transitions and reconcile the original key."},
    {"case": "leave_with_work", "code": "work_outstanding", "http_status": 409, "retryable": false, "active_mode": "team", "next_action": "Reconcile accepted or stopped work before leaving."},
    {"case": "malformed_body", "code": "invalid_request", "http_status": 400, "retryable": false, "active_mode": null, "next_action": "Correct the request under the original key before any new mutation."},
    {"case": "unsupported_protocol", "code": "unsupported_version", "http_status": 400, "retryable": false, "active_mode": null, "next_action": "Use a reviewed supported version."}
  ]
}
